{
  "name": "kids-code-maze",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "面向5-7岁儿童的零文字图形化编程闯关教具（Blockly + 自写迷宫）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "esbuild tools/check.ts --bundle --platform=node --outfile=tools/_check.mjs --format=esm && node tools/_check.mjs",
    "tts": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/gen-tts.ps1"
  },
  "dependencies": {
    "blockly": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
